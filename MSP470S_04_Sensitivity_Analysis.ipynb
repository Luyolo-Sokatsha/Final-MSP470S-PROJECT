      "source": [
        "import matplotlib.pyplot as plt\n",
        "w = SS[SS.split == \"test_warm\"]\n",
        "names = {\"Popularity\": \"Popularity\", \"A: BPR-MF\": \"A: BPR-MF\", \"B: Logistic regression\": \"B: Logistic regression\", \"B+: Logistic regression + popularity\": \"B+: LogReg + popularity\",\n",
        "         \"C: GNN (full)\": \"C: GNN\", \"C: GNN, no graph (features only)\": \"C: GNN without graph\"}\n",
        "fig, ax = plt.subplots(1, 2, figsize=(10, 4), sharey=True)\n",
        "for k, mu in enumerate(sorted(w.mean_interactions.unique())):\n",
        "    for m, lab in names.items():\n",
        "        s = w[(w.model == m) & (w.mean_interactions == mu)].sort_values(\"latent_weight\")\n",
        "        ax[k].plot(s.latent_weight, s[\"NDCG@10\"], marker=\"o\", lw=2.5 if m.startswith(\"C: GNN (\") else 1.3, label=lab)\n",
        "    ax[k].set_title(f\"About {mu} interactions per candidate\"); ax[k].set_xlabel(\"Strength of hidden collaborative signal\")\n",
        "ax[0].set_ylabel(\"NDCG@10 (warm candidates, test period)\"); ax[-1].legend(fontsize=8, frameon=False)\n",
        "plt.tight_layout(); plt.savefig(f\"{OUT}/fig_sensitivity.png\", dpi=150); plt.show()\n",
        "\n",
        "# shortfall of each model relative to the best model in each world (smaller is better)\n",
        "P = w.pivot_table(index=[\"latent_weight\", \"mean_interactions\"], columns=\"model\", values=\"NDCG@10\")[list(names)]\n",
        "R = P.rsub(P.max(axis=1), axis=0).abs().round(3); R.columns = list(names.values()); R.to_csv(f\"{OUT}/regret_table.csv\")\n",
        "display(R); display(pd.DataFrame({\"mean shortfall\": R.mean().round(3), \"largest shortfall\": R.max().round(3)}))"
      ]
    }
