      "source": [
        "import sys, json, subprocess, itertools\n",
        "import numpy as np, pandas as pd\n",
        "sys.path.insert(0, WORKDIR)\n",
        "from gen_core import make_data\n",
        "\n",
        "LAT, MU = [0.35, 1.0, 2.0], [12, 30]      # strength of hidden collaborative signal; mean contacts per candidate\n",
        "QUICK = False                              # True = run only the first world (about 3 minutes) as a test\n",
        "worlds = list(itertools.product(LAT, MU))[:1 if QUICK else None]\n",
        "OUT = f\"{WORKDIR}/results_sensitivity\"; TMP = f\"{WORKDIR}/sens_tmp\"\n",
        "rows = []\n",
        "for lat, mu in worlds:\n",
        "    name = f\"lat{lat}_mu{mu}\"; d = f\"{TMP}/{name}\"; res = f\"{OUT}/{name}\"\n",
        "    if not os.path.exists(f\"{res}/results_numeric.json\"):\n",
        "        os.makedirs(d, exist_ok=True); os.makedirs(res, exist_ok=True)\n",
        "        c, e, i = make_data(latent_weight=lat, mean_inter=mu)\n",
        "        c.to_csv(f\"{d}/candidates_clean.csv\", index=False); e.to_csv(f\"{d}/employers_clean.csv\", index=False); i.to_csv(f\"{d}/interactions_clean.csv\", index=False)\n",
        "        env = dict(os.environ, MSP_DATA=d, MSP_OUT=res, MSP_FAST=\"1\", MSP_SEEDS=\"0,1,2\")\n",
        "        print(\"running\", name, len(i), \"interactions\", flush=True)\n",
        "        r = subprocess.run([sys.executable, f\"{WORKDIR}/msp470s_models.py\"], env=env, capture_output=True, text=True)\n",
        "        if r.returncode: print(r.stderr[-2000:]); raise SystemExit(\"model run failed\")\n",
        "    J = json.load(open(f\"{res}/results_numeric.json\"))\n",
        "    for split in (\"test_warm\", \"test_cold\"):\n",
        "        for m, v in J[\"results\"][split].items():\n",
        "            rows.append({\"latent_weight\": lat, \"mean_interactions\": mu, \"split\": split, \"model\": m, \"Recall@10\": v[\"Recall@10\"], \"NDCG@10\": v[\"NDCG@10\"]})\n",
        "SS = pd.DataFrame(rows); SS.to_csv(f\"{OUT}/sensitivity_summary.csv\", index=False)\n",
        "SS[SS.split == \"test_warm\"].pivot_table(index=[\"latent_weight\", \"mean_interactions\"], columns=\"model\", values=\"NDCG@10\").round(3)"
      ]
    },
